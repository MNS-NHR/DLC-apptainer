BootStrap: docker
From: ubuntu:25.10

%labels
        APPLICATION_NAME Deeplabcut in Apptainer with GUI 
        AUTHOR_NAME Joanes Grandjean
        YEAR 2026
        Version 20260811

%help
        This container is based on DLC docker image, with added dependencies to make the GUI work

%environment
        PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
        LANG=C.UTF-8 LC_ALL=C.UTF-8
        DLClight=False
        QT_QPA_PLATFORM=xcb
%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Europe/Amsterdam
    export LANGUAGE=C.UTF-8 LC_ALL=C.UTF-8

    set -ex

    apt-get update
    apt-get install -y -V curl git build-essential

    # install uv
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/bin" sh

    # install deeplabcut on cuda 12.4
    mkdir /opt/dlc/
    cd /opt/dlc/
    uv venv --python 3.13
    uv pip install "deeplabcut[gui,modelzoo] @ git+https://github.com/DeepLabCut/DeepLabCut.git" --torch-backend=cu124

    # install dependencies for GUI
    apt-get install -y -V \
        mesa-utils \
        libxcb-xinerama0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxkbcommon-x11-0 \
        libxcb-xinput0 \
        libxcb-xfixes0 \
        libxcb-cursor0 \
        x11-utils \
        libopengl0 \
        libfontconfig1 \
        libxrender1 \
        libxi6 \
        libglx-mesa0 \
        libegl1 \
        libdbus-1-3 \
        libglib2.0-0 


# Install Deeplabcut gui

# Cleanup
        uv cache clean
        apt-get -qq clean
        rm -rf /var/lib/apt/lists/* 

%runscript
        unset SESSION_MANAGER
        . /opt/dlc/.venv/bin/activate
        python -m deeplabcut
